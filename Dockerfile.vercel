# NirmaanSetu — single-container Vercel deployment
# The React build is embedded into Spring Boot so frontend + backend deploy as ONE HTTP service.

FROM --platform=linux/amd64 node:22-alpine AS frontend-build
WORKDIR /workspace/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

FROM --platform=linux/amd64 maven:3.9.9-eclipse-temurin-21 AS backend-build
WORKDIR /workspace/backend

COPY backend/pom.xml ./
RUN mvn -B -ntp dependency:go-offline

COPY backend/src ./src
COPY --from=frontend-build /workspace/frontend/dist ./src/main/resources/static

RUN mvn -B -ntp -DskipTests package

FROM --platform=linux/amd64 eclipse-temurin:21-jre-alpine
WORKDIR /app

COPY --from=backend-build /workspace/backend/target/nirmaansetu-1.0.0.jar /app/app.jar

# Vercel injects PORT. Spring Boot reads ${PORT:8080} from application.properties.
ENV PORT=80
ENV JAVA_TOOL_OPTIONS="-Djava.awt.headless=true -XX:+UseSerialGC"

EXPOSE 80

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
